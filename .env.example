# Web3Forms API access key (client-side Vite env)
VITE_WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key

# Google Calendar appointment schedule booking page (optional).
# Google Calendar > Create > Appointment schedule > Share > Booking page link.
# When empty, "Book a call" buttons scroll to the contact form instead.
VITE_GOOGLE_BOOKING_URL=
