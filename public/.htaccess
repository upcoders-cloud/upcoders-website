Options -Indexes

# Bez tego Apache przekierowywałby /en na /en/, a kanoniczna forma adresu
# jest bez ukośnika na końcu.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Zabezpieczenie przed pętlą przy regule 4.
  RewriteRule ^.*/index\.html$ - [L]

  # 1. Wymuś HTTPS.
  #    Druga kondycja jest potrzebna, bo OVH terminuje SSL na proxy
  #    i samo %{HTTPS} bywa nieustawione.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://upcoders.cloud%{REQUEST_URI} [R=301,L]

  # 2. Adresy bez prefiksu językowego kierujemy na wersję domyślną (en).
  #    Wcześniej robił to React, czyli dopiero po pobraniu bundla i pod statusem 200.
  RewriteRule ^$ /en [R=301,L]
  RewriteRule ^projects/?$ /en/projects [R=301,L]
  RewriteRule ^projects/(.+)$ /en/projects/$1 [R=301,L]

  # 3. Ukośnik na końcu obcinamy, żeby /en/ i /en nie były dwoma adresami.
  RewriteRule ^((?:en|pl)(?:/.+)?)/$ /$1 [R=301,L]

  # 4. Strony wygenerowane przy buildzie (scripts/prerender.mjs).
  #    /en -> dist/en/index.html, /pl/projects -> dist/pl/projects/index.html
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(en|pl)(/.*)?$ %{REQUEST_URI}/index.html [L]

  # 5. Pozostałe istniejące pliki serwuj wprost.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 6. Fallback SPA wyłącznie dla tras językowych, których nie prerenderujemy.
  #    Wszystko poza /en i /pl leci dalej i dostaje prawdziwe 404 zamiast statusu 200.
  RewriteRule ^(en|pl)(/.*)?$ /index.html [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Bez includeSubDomains, żeby nie zablokować przyszłych subdomen bez HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"

  # Zasoby z hashem w nazwie (index-Dnh7QYe3.js) są niezmienne.
  # Wzorzec celowo nie łapie plików z public/, bo one hasha nie mają.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|ttf|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
